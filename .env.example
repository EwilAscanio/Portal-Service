# PostgreSQL (app) — usa estas variables o DATABASE_URL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=my_database
DB_USER=postgres
DB_PASSWORD=your_password

# Auth.js / NextAuth v5
AUTH_SECRET=your-random-secret-here

# Saint API
SAINT_API_URL=http://localhost:3001
SAINT_API_KEY=your-secure-api-key

# Documentos de cierre: carpeta privada persistente, compartida por las instancias.
# Predeterminado local: .private/service-order-documents.
# En el servidor usar una ruta absoluta fuera de public/.next y del despliegue.
# SERVICE_ORDER_DOCUMENTS_DIR=D:/MaquitechData/service-order-documents
